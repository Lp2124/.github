JWT_SECRET=replace-with-strong-access-token-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-strong-refresh-token-secret-at-least-32-chars
REFRESH_TOKEN_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
PORT=4000
RATE_LIMIT_WINDOW=60
