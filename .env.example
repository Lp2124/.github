DATABASE_URL=postgresql://app:app@localhost:5432/adult_video_saas?schema=public
JWT_SECRET=replace-with-strong-access-token-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-strong-refresh-token-secret-at-least-32-chars
REFRESH_TOKEN_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
PORT=4000
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=120
TRUST_PROXY_HOPS=0
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=example-user
SMTP_PASSWORD=example-password
SMTP_FROM=no-reply@example.test
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
